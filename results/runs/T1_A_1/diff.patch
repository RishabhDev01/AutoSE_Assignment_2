+def test_one_of_generator():
+    query = Query().key1.one_of(v for v in ['value 1', 'value 2'])
+    # Must work across many documents, not just the first evaluation
+    assert query({'key1': 'value 1'})
+    assert query({'key1': 'value 2'})
+    assert query({'key1': 'value 1'})
+    assert not query({'key1': 'value 3'})
+
+
+def test_one_of_generator_repeated_search():
+    from tinydb import TinyDB
+    from tinydb.storages import MemoryStorage
+
+    db = TinyDB(storage=MemoryStorage)
+    db.insert_multiple([{'k': 1}, {'k': 2}, {'k': 3}])
+    query = Query().k.one_of(x for x in [1, 3])
+    first = db.search(query)
+    second = db.search(query)
+    db.clear_cache()
+    third = db.search(query)
+    assert first == second == third == [{'k': 1}, {'k': 3}]
+
+
+def test_one_of_generator_list_equivalence():
+    q_list = Query().key1.one_of(['a', 'b'])
+    q_gen = Query().key1.one_of(v for v in ['a', 'b'])
+    assert q_list == q_gen
+    assert hash(q_list) == hash(q_gen)
+
+
+def test_one_of_unhashable():
+    query = Query().key1.one_of([{'a': 1}, [1, 2]])
+    assert query({'key1': {'a': 1}})
+    assert query({'key1': [1, 2]})
+    assert not query({'key1': {'a': 2}})
+    assert query.is_cacheable()
+
+    gen_query = Query().key1.one_of(v for v in [{'a': 1}, [1, 2]])
+    assert gen_query({'key1': {'a': 1}})
+    assert gen_query({'key1': [1, 2]})
+    assert gen_query == query
+
